# Local authentication key for this bridge (at least 16 characters).
# This is NOT an OpenAI API key; set the same value in AIRI's provider settings.
MUSE_BRIDGE_API_KEY=replace-with-a-long-random-local-key

# Directory containing existing muse-cli config.json and cookies.txt (read-only).
# Defaults to ~/.config/muse-cli when omitted.
# MUSE_BRIDGE_CONFIG_DIR=C:/Users/YourName/.config/muse-cli

# Directory where the SQLite journal and lockfile are stored.
# Defaults to ~/.local/state/muse-airi-bridge when omitted.
# MUSE_BRIDGE_STATE_DIR=C:/path/to/private/bridge-state

# Local HTTP bind address and port.
MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8000

# Seconds to wait for Muse's completed reply, and seconds between history polls.
MUSE_BRIDGE_REPLY_TIMEOUT=300
MUSE_BRIDGE_POLL_INTERVAL=1

# Prepend AIRI <|ACT ...|> emotion markers to replies.
# Setting false disables only ACT marker insertion; invisible input headers and footer removal stay enabled.
MUSE_BRIDGE_EMOTIONS=true
